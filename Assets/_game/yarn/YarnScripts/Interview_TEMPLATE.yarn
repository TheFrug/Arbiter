title: Interview_TEMPLATE
---
// ==========================
// ===== INITIAL SETUP ======
// ==========================

<<form_reset YarnManager>>

<<set $asked_name = false>>
<<set $asked_occupation = false>>
<<set $asked_loyalty = false>>

// ==========================
// ===== ENTRY POINT ========
// ==========================

<<jump TEMPLATE_Intro>>
===


title: TEMPLATE_Intro
---
CONTENT

-> CONTENT
-> CONTENT
-> CONTENT #skillcheck:Force:9
    <<SkillCheck "YarnManager" "Force" 9>>
    <<if $last_check_success>>
        <<detour TEMPLATE_Late_Pass>>
    <<else>>
        <<detour TEMPLATE_Late_Fail>>
    <<endif>>

CONTENT

<<jump TEMPLATE_Hub>>
===


title: TEMPLATE_Late_Pass
---
CONTENT
===


title: TEMPLATE_Late_Fail
---
CONTENT
===


// ==========================
// ===== HUB LOOP ===========
// ==========================

title: TEMPLATE_Hub
---
CONTENT

-> CONTENT <<once>>
    <<jump TEMPLATE_Name>>

-> CONTENT <<if not $asked_occupation>>
    <<jump TEMPLATE_Occupation>>

-> CONTENT <<if not $asked_loyalty>>
    <<jump TEMPLATE_Loyalty>>

-> CONTENT <<if $asked_name and $asked_occupation and $asked_loyalty>>
    <<jump TEMPLATE_End>>
===


// ==========================
// ===== NAME ===============
// ==========================

title: TEMPLATE_Name
---
CONTENT

<<form_set_name YarnManager "CONTENT">>
<<set $asked_name = true>>

<<SkillCheck "YarnManager" "Empathy" 7>>
<<if $last_check_success>>
CONTENT
<<endif>>

<<SkillCheck "YarnManager" "Insight" 7>>
<<if $last_check_success>>
CONTENT
<<endif>>

-> CONTENT
-> CONTENT <<if $last_check_success>>
    <<detour TEMPLATE_Name_Followup>>

<<jump TEMPLATE_Hub>>
===


title: TEMPLATE_Name_Followup
---
CONTENT
===


// ==========================
// ===== OCCUPATION =========
// ==========================

title: TEMPLATE_Occupation
---
<<form_set_occupation YarnManager "CONTENT">>

CONTENT

<<SkillCheck "YarnManager" "Insight" 9>>
<<if $last_check_success>>
CONTENT

    <<SkillCheck "YarnManager" "Empathy" 7>>
    <<if $last_check_success>>
    CONTENT
    <<endif>>

<<endif>>

-> CONTENT
-> CONTENT
    <<form_set_occupation YarnManager "CONTENT">>

<<set $asked_occupation = true>>
<<jump TEMPLATE_Hub>>
===


// ==========================
// ===== LOYALTY ============
// ==========================

title: TEMPLATE_Loyalty
---
CONTENT

<<SkillCheck "YarnManager" "Insight" 6>>
<<if $last_check_success>>
CONTENT
<<endif>>

<<SkillCheck "YarnManager" "Empathy" 9>>
<<if $last_check_success>>
CONTENT
<<endif>>

<<set $asked_loyalty = true>>
<<jump TEMPLATE_Hub>>
===


// ==========================
// ===== END ================
// ==========================

title: TEMPLATE_End
---
CONTENT

<<form_submit YarnManager>>
===