<<if $last_check_success>>
CONTENT
<<endif>>

<<SkillCheck "YarnManager" "Empathy" 9>>
<<if $last_check_success>>
CONTENT
<<endif>>

<<set $asked_loyalty = true>>
<<jump EthanMiller_Hub>>
